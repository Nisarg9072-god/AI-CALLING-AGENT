# ─────────────────────────────────────────────
#  AI Calling Agent — Environment Configuration
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── LLM Provider ─────────────────────────────
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-openai-api-key-here
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# ── Agent Limits (Deterministic) ─────────────
MAX_TURNS=20
MAX_TOOL_CALLS=10
MAX_RETRIES=3
TOOL_TIMEOUT_SECONDS=10

# ── Guardrails ────────────────────────────────
# Comma-separated list of tools that require customer verification first
SENSITIVE_TOOLS=update_delivery_address,cancel_order,update_account

# ── Voice Layer ───────────────────────────────
ENABLE_VOICE=false
VOICE_PROVIDER=mock

# ── Observability ─────────────────────────────
LOG_LEVEL=INFO
TRACE_TO_FILE=true
TRACE_DIR=./traces

# ── Database ─────────────────────────────────
# Use "memory" for in-memory SQLite, or a file path for persistent SQLite
DB_URL=memory

# ── Development ───────────────────────────────
DEBUG=false
