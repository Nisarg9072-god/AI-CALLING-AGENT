# ─────────────────────────────────────────────────────
#  AI Calling Agent v2 — Environment Configuration
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────

# ── LLM Provider ─────────────────────────────────────
LLM_PROVIDER=mistral

# Mistral AI — get your key at https://console.mistral.ai
MISTRAL_API_KEY=your-mistral-api-key-here

# Available models (cost order: small < medium < large):
#   mistral-small-latest    ← default (recommended for dev/cost)
#   mistral-medium-latest
#   mistral-large-latest    ← best quality
#   open-mixtral-8x7b       ← open weights
MISTRAL_MODEL=mistral-small-latest

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# ── Agent Limits (Deterministic — not LLM-controlled) ─
MAX_TURNS=20
MAX_TOOL_CALLS=10
MAX_RETRIES=3
TOOL_TIMEOUT_SECONDS=10

# ── Guardrails ────────────────────────────────────────
# Tools that REQUIRE customer identity verification first
SENSITIVE_TOOLS=["update_delivery_address","cancel_order","update_account"]

# ── Database ─────────────────────────────────────────
# SQLite file path (relative to project root)
DATABASE_URL=sqlite+aiosqlite:///./data/agent.db

# ── FastAPI Server ────────────────────────────────────
HOST=0.0.0.0
PORT=8000
RELOAD=true

# ── Telephony — Twilio ────────────────────────────────
# REQUIRES PROVIDER CONFIGURATION — Twilio trial restricts call destinations.
TELEPHONY_PROVIDER=mock

TWILIO_ACCOUNT_SID=your-account-sid-here
TWILIO_AUTH_TOKEN=your-auth-token-here
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
# Destination number (E.164 format). Overridden per-call via API.
TWILIO_TO_NUMBER=+919537266092

# ── Voice Pipeline ────────────────────────────────────
VOICE_MODE=text          # text | local | twilio

# STT — faster-whisper (local, free)
STT_PROVIDER=faster_whisper
# Model size: tiny, base, small, medium, large-v2, large-v3
STT_MODEL=base
STT_DEVICE=cpu           # cpu | cuda

# TTS — Piper (local, free)
TTS_PROVIDER=piper
# Voice model file path (download from https://github.com/rhasspy/piper/releases)
PIPER_MODEL_PATH=./data/voices/en_US-amy-medium.onnx

# ── Observability ─────────────────────────────────────
LOG_LEVEL=INFO
TRACE_TO_FILE=true
TRACE_DIR=./data/traces

# ── Development ───────────────────────────────────────
DEBUG=false
ENVIRONMENT=development
